{
  "m2plug": "0.1",
  "id": "m2/pluck",
  "name": "Pluck",
  "kind": "instrument",
  "description": "Short, bright, slightly detuned pluck. Great for chord stabs and arps.",
  "tags": ["pluck", "chords", "arp", "bright"],
  "macros": [
    {"id": "tone", "name": "Tone", "default": 0.55, "description": "Filter brightness"},
    {"id": "decay", "name": "Decay", "default": 0.35, "description": "How long each note rings"},
    {"id": "width", "name": "Width", "default": 0.5, "description": "Detune between the oscillators"}
  ],
  "voice": {
    "nodes": [
      {"id": "osc", "type": "osc", "params": {"wave": "saw", "unison": 3, "detune": {"macro": "width", "from": 2, "to": 24}, "spread": 0.7}},
      {"id": "fenv", "type": "env", "params": {"a": 0.001, "d": {"macro": "decay", "from": 0.06, "to": 0.6}, "s": 0, "r": 0.15}},
      {"id": "aenv", "type": "env", "params": {"a": 0.002, "d": {"macro": "decay", "from": 0.15, "to": 1.6}, "s": 0, "r": 0.2}},
      {"id": "flt", "type": "filter", "params": {"mode": "lp", "cutoff": {"macro": "tone", "from": 300, "to": 5000, "curve": "exp"}, "q": 0.9, "mod_amount": 3, "keytrack": 0.5},
       "inputs": {"in": "osc", "mod": "fenv"}},
      {"id": "amp", "type": "vca", "params": {"gain": 0.62, "velocity": 0.6}, "inputs": {"in": "flt", "cv": "aenv"}}
    ],
    "out": "amp"
  }
}
