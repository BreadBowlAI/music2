{
  "m2plug": "0.1",
  "id": "m2/keys",
  "name": "Electric Keys",
  "kind": "instrument",
  "description": "FM electric piano with a bell-like bite. Good for piano-house chords and ballads.",
  "tags": ["keys", "piano", "rhodes", "chords"],
  "macros": [
    {"id": "bark", "name": "Bark", "default": 0.4, "description": "Bell-like attack"},
    {"id": "decay", "name": "Decay", "default": 0.5}
  ],
  "voice": {
    "nodes": [
      {"id": "menv", "type": "env", "params": {"a": 0.001, "d": 0.35, "s": 0.05, "r": 0.3}},
      {"id": "mod", "type": "osc", "params": {"wave": "sine", "octave": 1}},
      {"id": "mamp", "type": "vca", "params": {"velocity": 0.8}, "inputs": {"in": "mod", "cv": "menv"}},
      {"id": "car", "type": "osc", "params": {"wave": "sine", "fm_amount": {"macro": "bark", "from": 0, "to": 9}}, "inputs": {"fm": "mamp"}},
      {"id": "tine", "type": "osc", "params": {"wave": "triangle", "octave": 1, "level": 0.18}},
      {"id": "aenv", "type": "env", "params": {"a": 0.002, "d": {"macro": "decay", "from": 0.5, "to": 3.5}, "s": 0.2, "r": 0.35}},
      {"id": "amp", "type": "vca", "params": {"gain": 0.45, "velocity": 0.7}, "inputs": {"in": ["car", "tine"], "cv": "aenv"}}
    ],
    "out": "amp"
  },
  "post": {
    "nodes": [
      {"id": "trem", "type": "chorus", "params": {"rate": 0.8, "depth": 3, "mix": 0.3}, "inputs": {"in": "in"}},
      {"id": "verb", "type": "reverb", "params": {"size": 0.6, "damp": 0.5, "mix": 0.15}, "inputs": {"in": "trem"}}
    ],
    "out": "verb"
  }
}
