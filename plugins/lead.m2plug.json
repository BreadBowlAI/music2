{
  "m2plug": "0.1",
  "id": "m2/lead",
  "name": "Supersaw Lead",
  "kind": "instrument",
  "description": "Big, wide 7-voice supersaw with a sub octave. The euphoric pop-anthem lead.",
  "tags": ["lead", "supersaw", "hook", "anthem"],
  "polyphony": 8,
  "macros": [
    {"id": "brightness", "name": "Brightness", "default": 0.6},
    {"id": "width", "name": "Width", "default": 0.55},
    {"id": "space", "name": "Space", "default": 0.35, "description": "Echo and reverb"}
  ],
  "voice": {
    "nodes": [
      {"id": "saw", "type": "osc", "params": {"wave": "saw", "unison": 7, "detune": {"macro": "width", "from": 6, "to": 38}, "spread": 0.9}},
      {"id": "sub", "type": "osc", "params": {"wave": "square", "octave": -1, "level": 0.3}},
      {"id": "fenv", "type": "env", "params": {"a": 0.005, "d": 0.4, "s": 0.3, "r": 0.3}},
      {"id": "flt", "type": "filter", "params": {"mode": "lp", "cutoff": {"macro": "brightness", "from": 900, "to": 9000, "curve": "exp"}, "q": 0.8, "mod_amount": 1.5},
       "inputs": {"in": ["saw", "sub"], "mod": "fenv"}},
      {"id": "aenv", "type": "env", "params": {"a": 0.01, "d": 0.3, "s": 0.8, "r": 0.3}},
      {"id": "amp", "type": "vca", "params": {"gain": 0.33, "velocity": 0.4}, "inputs": {"in": "flt", "cv": "aenv"}}
    ],
    "out": "amp"
  },
  "post": {
    "nodes": [
      {"id": "echo", "type": "delay", "params": {"time": 0.75, "feedback": 0.3, "mix": {"macro": "space", "from": 0, "to": 0.3}, "pingpong": 1}, "inputs": {"in": "in"}},
      {"id": "verb", "type": "reverb", "params": {"size": 0.75, "damp": 0.5, "mix": {"macro": "space", "from": 0.05, "to": 0.4}}, "inputs": {"in": "echo"}}
    ],
    "out": "verb"
  }
}
