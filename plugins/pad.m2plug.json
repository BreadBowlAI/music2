{
  "m2plug": "0.1",
  "id": "m2/pad",
  "name": "Glow Pad",
  "kind": "instrument",
  "description": "Warm, slow-blooming pad with a gentle pump. Fills the space under a vocal.",
  "tags": ["pad", "chords", "warm", "ambient"],
  "macros": [
    {"id": "brightness", "name": "Brightness", "default": 0.45},
    {"id": "attack", "name": "Attack", "default": 0.3, "description": "How slowly notes fade in"},
    {"id": "space", "name": "Space", "default": 0.5},
    {"id": "pump", "name": "Pump", "default": 0.35, "description": "Sidechain-style ducking on every beat"}
  ],
  "voice": {
    "nodes": [
      {"id": "saw", "type": "osc", "params": {"wave": "saw", "unison": 5, "detune": 16, "spread": 0.8}},
      {"id": "air", "type": "osc", "params": {"wave": "triangle", "octave": 1, "level": 0.3}},
      {"id": "wob", "type": "lfo", "params": {"rate": 0.15, "depth": 0.5}},
      {"id": "flt", "type": "filter", "params": {"mode": "lp", "cutoff": {"macro": "brightness", "from": 500, "to": 6000, "curve": "exp"}, "q": 0.6, "mod_amount": 0.6, "keytrack": 0.3},
       "inputs": {"in": ["saw", "air"], "mod": "wob"}},
      {"id": "aenv", "type": "env", "params": {"a": {"macro": "attack", "from": 0.01, "to": 1.5, "curve": "exp"}, "d": 1.0, "s": 0.85, "r": 1.0}},
      {"id": "amp", "type": "vca", "params": {"gain": 0.13, "velocity": 0.3}, "inputs": {"in": "flt", "cv": "aenv"}}
    ],
    "out": "amp"
  },
  "post": {
    "nodes": [
      {"id": "cho", "type": "chorus", "params": {"rate": 0.4, "depth": 5, "mix": 0.4}, "inputs": {"in": "in"}},
      {"id": "verb", "type": "reverb", "params": {"size": 0.85, "damp": 0.4, "mix": {"macro": "space", "from": 0.1, "to": 0.6}}, "inputs": {"in": "cho"}},
      {"id": "duck", "type": "pump", "params": {"depth": {"macro": "pump", "from": 0, "to": 0.8}, "release": 0.6}, "inputs": {"in": "verb"}}
    ],
    "out": "duck"
  }
}
