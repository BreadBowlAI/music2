  ],
  "graph": {"nodes": [
    {"id": "duck", "type": "comp", "params": {
      "threshold": {"macro": "depth", "from": -6, "to": -36},
      "ratio": 12,
      "attack": 0.001,
      "release": {"macro": "release", "from": 0.04, "to": 0.4, "curve": "exp"}
    }, "inputs": {"in": "in", "sidechain": "sidechain"}}
  ], "out": "duck"}
}
