{
  "m2plug": "0.1",
  "id": "m2/strings",
  "name": "Disco Strings",
  "kind": "instrument",
  "description": "Lush ensemble strings with a fast swell. Disco stabs, sweeping chorus lines.",
  "tags": ["strings", "disco", "ensemble", "chords"],
  "macros": [
    {"id": "swell", "name": "Swell", "default": 0.3},
    {"id": "brightness", "name": "Brightness", "default": 0.55}
  ],
  "voice": {
    "nodes": [
      {"id": "saw", "type": "osc", "params": {"wave": "saw", "unison": 4, "detune": 14, "spread": 0.9}},
      {"id": "vib", "type": "lfo", "params": {"rate": 5.2, "depth": 0.08}},
      {"id": "saw2", "type": "osc", "params": {"wave": "saw", "octave": 1, "level": 0.25, "fm_amount": 1}, "inputs": {"fm": "vib"}},
      {"id": "flt", "type": "filter", "params": {"mode": "lp", "cutoff": {"macro": "brightness", "from": 1200, "to": 9000, "curve": "exp"}, "q": 0.5},
       "inputs": {"in": ["saw", "saw2"]}},
      {"id": "aenv", "type": "env", "params": {"a": {"macro": "swell", "from": 0.01, "to": 0.6, "curve": "exp"}, "d": 0.6, "s": 0.85, "r": 0.4}},
      {"id": "amp", "type": "vca", "params": {"gain": 0.25, "velocity": 0.5}, "inputs": {"in": "flt", "cv": "aenv"}}
    ],
    "out": "amp"
  },
  "post": {
    "nodes": [
      {"id": "ens", "type": "chorus", "params": {"rate": 0.5, "depth": 7, "mix": 0.5}, "inputs": {"in": "in"}},
      {"id": "verb", "type": "reverb", "params": {"size": 0.8, "damp": 0.45, "mix": 0.25}, "inputs": {"in": "ens"}}
    ],
    "out": "verb"
  }
}
