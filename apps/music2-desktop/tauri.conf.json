{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "music2",
  "mainBinaryName": "music2",
  "version": "0.1.0",
  "identifier": "ai.breadbowl.music2",
  "build": {
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../web"
    },
    "beforeBundleCommand": {
      "script": "bash apps/music2-desktop/bundle-m2.sh",
      "cwd": "../.."
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "deb",
      "appimage"
    ],
    "category": "Music",
    "shortDescription": "Music studio",
    "longDescription": "music2 is a music studio (a DAW) where a song is a folder that is a small program: code says how it sounds, data files say what plays. Make songs on a timeline, a piano roll and a mixer, play CLAP plugins, and let scripts and agents help through the m2 command line.",
    "publisher": "The music2 authors <mxudev@gmail.com>",
    "copyright": "Copyright (c) 2026 The music2 authors. MIT OR Apache-2.0.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../web/dist/": "web/",
      "../../std/m2pkg.toml": "std/m2pkg.toml",
      "../../std/kernels/*.wasm": "std/kernels/",
      "../../std/src/": "std/src/",
      "../../std/samples.toml": "std/samples.toml",
      "../../std/samples/kit/*.wav": "std/samples/kit/",
      "../../packs/": "packs/",
      "../../templates/": "templates/",
      "../../examples/": "examples/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.35)",
          "libasound2",
          "libdbus-1-3"
        ],
        "files": {
          "/usr/bin/m2": "../../target/release/m2",
          "/usr/share/doc/music2/LICENSE-MIT": "../../LICENSE-MIT",
          "/usr/share/doc/music2/LICENSE-APACHE": "../../LICENSE-APACHE",
          "/usr/share/doc/music2/THIRD-PARTY-NOTICES.txt": "../../target/notices/THIRD-PARTY-NOTICES.txt",
          "/usr/share/doc/music2/copyright": "copyright"
        }
      },
      "appimage": {
        "files": {
          "/usr/bin/m2": "../../target/release/m2",
          "/usr/share/doc/music2/LICENSE-MIT": "../../LICENSE-MIT",
          "/usr/share/doc/music2/LICENSE-APACHE": "../../LICENSE-APACHE",
          "/usr/share/doc/music2/THIRD-PARTY-NOTICES.txt": "../../target/notices/THIRD-PARTY-NOTICES.txt"
        }
      }
    },
    "macOS": {
      "files": {
        "MacOS/m2": "../../target/release/m2",
        "Resources/LICENSE-MIT": "../../LICENSE-MIT",
        "Resources/LICENSE-APACHE": "../../LICENSE-APACHE",
        "Resources/THIRD-PARTY-NOTICES.txt": "../../target/notices/THIRD-PARTY-NOTICES.txt"
      },
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
