{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "music2",
  "version": "0.1.0",
  "identifier": "com.suite2.music2",
  "build": {
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../web"
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Music",
    "shortDescription": "Music studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../web/dist/": "web/",
      "../../std/m2pkg.toml": "std/m2pkg.toml",
      "../../std/kernels/*.wasm": "std/kernels/",
      "../../std/src/": "std/src/",
      "../../templates/": "templates/",
      "../../examples/": "examples/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
