{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "music2",
  "mainBinaryName": "music2",
  "version": "0.1.0",
  "identifier": "ai.breadbowl.music2",
  "build": {
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../web"
    },
    "beforeBundleCommand": {
      "script": "bash apps/music2-desktop/bundle-m2.sh",
      "cwd": "../.."
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "deb",
      "appimage"
    ],
    "category": "Music",
    "shortDescription": "Music studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../web/dist/": "web/",
      "../../std/m2pkg.toml": "std/m2pkg.toml",
      "../../std/kernels/*.wasm": "std/kernels/",
      "../../std/src/": "std/src/",
      "../../std/presets/": "std/presets/",
      "../../templates/": "templates/",
      "../../examples/": "examples/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.39)",
          "libasound2",
          "libdbus-1-3"
        ],
        "files": {
          "/usr/bin/m2": "../../target/release/m2"
        }
      },
      "appimage": {
        "files": {
          "/usr/bin/m2": "../../target/release/m2"
        }
      }
    },
    "macOS": {
      "files": {
        "MacOS/m2": "../../target/release/m2"
      },
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
