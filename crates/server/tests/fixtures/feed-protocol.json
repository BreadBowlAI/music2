{
  "protocol": "feed/1",
  "about": "The feed/1 protocol's acts, in order, on one song, and what each answer must be: docs/guide/feed-protocol.md says it in words. crates/server/src/feed_protocol_tests.rs runs it against the app's routes. In `answers`, a field's type ends in `?` when it may be absent, and `|null` when it may be null; a list holds one shape. In a step, `is` names fields (a path with dots) that must have that value, `refused` is a refusal's exact words, `refused_starting` its first words, `many` makes a put's notes, `told` says the same state is an event too, and `musician` is something the musician does, which isn't feed/1.",
  "song": {"example": "first-song", "bpm": 124, "beats_a_bar": 4},
  "envelope": {"session": "the app's, on each body and in each answer: which open song. A page's Song is its session, so it isn't feed/1"},
  "answers": {
    "state": {
      "t": "string",
      "feed": "string",
      "track": "string",
      "lane": "string",
      "writer": "string|null",
      "why": "string?",
      "playing": "bool",
      "playhead": "number",
      "lock": "number",
      "written_to": "number",
      "buffer": {"beats": "number", "bars": "number", "seconds": "number"},
      "low_bars": "number",
      "low_mark": {"beats": "number", "bars": "number"},
      "notes": "number",
      "empties": "number",
      "late": "number",
      "heard": "bool",
      "silent": "string?"
    },
    "put": {
      "ok": "bool",
      "taken": "number",
      "late": "number",
      "lock": "number",
      "written_to": "number",
      "playhead": "number",
      "heard": "bool"
    },
    "status": {"feeds": ["state"]},
    "refusal": {"error": "string"}
  },
  "steps": [
    {"say": "no feed is open yet", "act": "status", "body": {}, "answer": "status", "is": {"feeds": []}},

    {"say": "the song itself isn't a track", "act": "open", "body": {"track": "song"},
     "refused": "song isn't a track: a feed plays a track's notes, which shows Live on its header."},
    {"say": "no such track", "act": "open", "body": {"track": "drums"},
     "refused": "The song has no track `drums`: `m2 check` lists its tracks and their lanes."},
    {"say": "a lane that isn't a notes lane", "act": "open", "body": {"track": "bass", "lane": "cutoff"},
     "refused": "bass has no notes lane `cutoff`: it has notes."},
    {"say": "a low mark of 0", "act": "open", "body": {"track": "bass", "low_bars": 0},
     "refused": "The low mark is a number of bars above 0, at most 64: not 0."},
    {"say": "a low mark past 64 bars", "act": "open", "body": {"track": "bass", "low_bars": 65},
     "refused": "The low mark is a number of bars above 0, at most 64: not 65."},
    {"say": "an open without a track", "act": "open", "body": {"low_bars": 4},
     "refused_starting": "The body doesn't read: "},
    {"say": "a put before any open", "act": "put", "body": {"feed": "bass", "from": 0, "to": 4, "notes": []},
     "refused": "bass has no feed open: open one first (`m2 feed open`)."},
    {"say": "a close before any open", "act": "close", "body": {"feed": "bass"},
     "refused": "bass has no feed open."},

    {"say": "open a feed on the bass", "act": "open", "body": {"track": "bass", "low_bars": 4, "as": "Claude"},
     "answer": "state", "told": true,
     "is": {"why": "open", "t": "feed", "feed": "bass", "track": "bass", "lane": "notes", "writer": "Claude",
            "playing": false, "playhead": 0, "lock": 0, "written_to": 0, "buffer.beats": 0, "buffer.bars": 0, "buffer.seconds": 0,
            "low_bars": 4, "low_mark.beats": 16, "low_mark.bars": 4, "notes": 0, "empties": 0, "late": 0, "heard": true}},
    {"say": "a second feed on the same track", "act": "open", "body": {"track": "bass"},
     "refused": "bass already has a feed open: close it first, or write to it."},

    {"say": "`to` before `from`", "act": "put", "body": {"feed": "bass", "from": 8, "to": 4, "notes": []},
     "refused": "A put's `from` and `to` are beats, `from` 0 or more and `to` after it: not 8 to 4."},
    {"say": "`from` below 0", "act": "put", "body": {"feed": "bass", "from": -1, "to": 4, "notes": []},
     "refused": "A put's `from` and `to` are beats, `from` 0 or more and `to` after it: not -1 to 4."},
    {"say": "more than 64 bars past the playhead", "act": "put", "body": {"feed": "bass", "from": 0, "to": 300, "notes": []},
     "refused": "A feed holds at most 64 bars past the playhead (beat 0.00): `to` is beat 300, 75.0 bars past it. A feed is a buffer, not a song: write the next few bars, and more as they play."},
    {"say": "a note outside the range", "act": "put", "body": {"feed": "bass", "from": 0, "to": 4, "notes": [{"pitch": 45, "start": 4, "length": 0.5}]},
     "refused": "Each note starts inside the put's range, from beat 0 to before 4: a note starts at 4."},
    {"say": "a note 0 beats long", "act": "put", "body": {"feed": "bass", "from": 0, "to": 4, "notes": [{"pitch": 45, "start": 1, "length": 0}]},
     "refused": "A note's length is above 0 beats: the note at 1 is 0 long."},
    {"say": "a pitch past 127", "act": "put", "body": {"feed": "bass", "from": 0, "to": 4, "notes": [{"pitch": 128, "start": 1, "length": 0.5}]},
     "refused": "A note's pitch is 0 to 127: the note at 1 is 128."},
    {"say": "a velocity past 1", "act": "put", "body": {"feed": "bass", "from": 0, "to": 4, "notes": [{"pitch": 45, "start": 1, "length": 0.5, "velocity": 1.5}]},
     "refused": "A note's velocity is 0 to 1: the note at 1 is 1.5."},
    {"say": "a pitch with no name", "act": "put", "body": {"feed": "bass", "from": 0, "to": 4, "notes": [{"pitch": "H2", "start": 1, "length": 0.5}]},
     "refused_starting": "The body doesn't read: "},
    {"say": "a put without `to`", "act": "put", "body": {"feed": "bass", "from": 0, "notes": []},
     "refused_starting": "The body doesn't read: "},
    {"say": "65 notes starting at once", "act": "put", "body": {"feed": "bass", "from": 0, "to": 4},
     "many": {"count": 65, "pitch": 40, "pitch_step": 1, "start": 1, "step": 0, "length": 0.5},
     "refused": "That's more notes at once than a feed plays: at most 128 sounding together, and 64 starting within 128 samples. Write fewer."},
    {"say": "4,097 notes", "act": "put", "body": {"feed": "bass", "from": 0, "to": 208},
     "many": {"count": 4097, "pitch": 45, "pitch_step": 0, "start": 0, "step": 0.05, "length": 0.04},
     "refused": "A feed holds at most 4,096 notes: this put would make it 4097. Write fewer, or let the bars behind play out first."},

    {"say": "two notes, a pitch by its name", "act": "put",
     "body": {"feed": "bass", "from": 0, "to": 8, "notes": [{"pitch": "A1", "start": 0, "length": 0.5}, {"pitch": 45, "start": 4, "length": 0.5, "velocity": 0.9}], "as": "Claude"},
     "answer": "put", "is": {"ok": true, "taken": 2, "late": 0, "lock": 0, "written_to": 8, "playhead": 0, "heard": true}},
    {"say": "a rest: no notes from beat 8 to 12", "act": "put", "body": {"feed": "bass", "from": 8, "to": 12, "notes": [], "as": "Claude"},
     "answer": "put", "is": {"taken": 0, "late": 0, "written_to": 12}},
    {"say": "the feed, stopped", "act": "status", "body": {}, "answer": "status",
     "is": {"feeds.0.feed": "bass", "feeds.0.written_to": 12, "feeds.0.buffer.beats": 12, "feeds.0.buffer.bars": 3, "feeds.0.notes": 2, "feeds.0.writer": "Claude"},
     "absent": ["feeds.0.why"]},

    {"say": "the musician presses Play; the playhead passes beat 1", "musician": {"play_to": 1}},
    {"say": "a put across the playhead: the note before the lock is late", "act": "put",
     "body": {"feed": "bass", "from": 0, "to": 16, "notes": [{"pitch": 45, "start": 0.5, "length": 0.25}, {"pitch": 47, "start": 2, "length": 0.5}], "as": "Claude"},
     "answer": "put", "is": {"taken": 1, "late": 1, "written_to": 16}, "lock_ahead_seconds_at_least": 0.05},
    {"say": "the feed, playing", "act": "status", "body": {}, "answer": "status",
     "is": {"feeds.0.playing": true, "feeds.0.late": 1, "feeds.0.notes": 2, "feeds.0.written_to": 16}},
    {"say": "close it while it plays", "act": "close", "body": {"feed": "bass"}, "answer": "state", "told": true,
     "is": {"why": "closed", "feed": "bass", "playing": true, "notes": 0}},
    {"say": "closed: no feed is open", "act": "status", "body": {}, "answer": "status", "is": {"feeds": []}}
  ]
}
